---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import Headline from '~/components/ui/Headline.astro';
import { examples, demos, sourceUrl, repoUrl, recordedOn } from '~/data/catalog';
import type { Example } from '~/data/catalog';

const metadata = {
  title: 'Examples',
  description:
    'Code to read and run: the compiler’s examples and showcase, server modules, graphics, text shaping and the component-model experiments.',
};

const kinds: Array<{ kind: Example['kind']; title: string; subtitle: string }> = [
  { kind: 'language', title: 'The language', subtitle: 'F# programs compiled to WebAssembly GC and checked end to end.' },
  { kind: 'components', title: 'Components', subtitle: 'WIT worlds and modules linked at run time.' },
  { kind: 'backend', title: 'Backend', subtitle: 'A server module in F#, and the matrix that runs it on every platform.' },
  { kind: 'graphics', title: 'Graphics', subtitle: 'Scenes, rasterizers and hosts.' },
  { kind: 'text', title: 'Text', subtitle: 'Shaping and layout.' },
  { kind: 'tools', title: 'Tools', subtitle: 'Programs written in F# for F# programmers.' },
  { kind: 'research', title: 'Experiments', subtitle: 'What we tried, with the numbers.' },
];
---

<Layout metadata={metadata}>
  <HeroText
    tagline="Read and run"
    title="Examples"
    subtitle={`Code to read and to run, from a tested set of classic algorithms to a server module on six platforms. Each has its source, the command that runs it and, where there is one, the number of checks it carries (recorded ${recordedOn}).`}
    callToAction={{ variant: 'primary', text: 'Live demos', href: '/demos', icon: 'tabler:player-play' }}
    callToAction2={{ variant: 'secondary', text: 'Tests', href: '/tests', icon: 'tabler:checklist' }}
  />

  {
    kinds.map(({ kind, title, subtitle }) => (
      <WidgetWrapper id={kind}>
        <Headline title={title} subtitle={subtitle} classes={{ container: 'mb-6 md:mb-8' }} />
        <ul class="max-w-5xl mx-auto grid gap-6 sm:grid-cols-2 list-none p-0">
          {examples
            .filter((e) => e.kind === kind)
            .map((e) => (
              <li class="rounded-md border border-slate-200 dark:border-slate-700 p-5">
                <h3 class="text-xl font-bold">{e.title}</h3>
                <p class="mt-2 text-muted">{e.summary}</p>
                {e.checks && <p class="mt-2 text-sm font-semibold">{e.checks} checks</p>}
                {e.run && (
                  <p class="mt-3 text-sm">
                    Run: <code class="break-words">{e.run}</code>
                  </p>
                )}
                <p class="mt-3 text-sm">
                  <a href={sourceUrl(e.repo, e.path)} class="underline" target="_blank" rel="noopener">
                    Source
                  </a>
                  {' · '}
                  <a href={repoUrl(e.repo)} target="_blank" rel="noopener" class="underline">
                    {e.repo}
                  </a>
                </p>
              </li>
            ))}
        </ul>
      </WidgetWrapper>
    ))
  }

  <WidgetWrapper id="demos">
    <Headline
      title="And the live demos"
      subtitle={`The ${demos.length} demos on the demos page are examples too: every one has its source in fsharp-wasm-runtime.`}
    />
    <p class="text-center"><a href="/demos" class="underline">See the live demos</a></p>
  </WidgetWrapper>

  <CallToAction
    actions={[
      { variant: 'primary', text: 'Get started', href: '/docs/getting-started', icon: 'tabler:rocket' },
      { text: 'Benchmarks', href: '/benchmarks', icon: 'tabler:chart-bar' },
    ]}
  />
</Layout>

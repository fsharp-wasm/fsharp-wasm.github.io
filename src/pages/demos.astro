---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import Features3 from '~/components/widgets/Features3.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import { demos, demoUrl } from '~/data/catalog';
import type { DemoGroup } from '~/data/catalog';

const metadata = {
  title: 'Live demos',
  description:
    'Every demo runs live in your browser: F# compiled to WebAssembly GC, from a counter to a visual widget editor.',
};

const open = (d: (typeof demos)[number]) => ({ text: 'Open the demo', href: demoUrl(d), icon: 'tabler:player-play' });

const groups: Array<{ group: DemoGroup; tagline: string; title: string; subtitle: string; columns: 2 | 3 }> = [
  { group: 'apps', tagline: 'Applications', title: 'Interfaces written in F#', subtitle: 'The model, the update and the view are F#; the page is real HTML.', columns: 2 },
  { group: 'platform', tagline: 'The platform', title: 'Browser APIs from F#', subtitle: 'Typed bindings, no JavaScript application code.', columns: 2 },
  { group: 'graphics', tagline: 'Graphics', title: 'Drawn by the module', subtitle: 'These draw pixels onto a canvas, so they are visual demos, not accessible interfaces. A GUI layer that renders real, accessible HTML is on the roadmap.', columns: 3 },
  { group: 'measure', tagline: 'Measure', title: 'Run the benchmark', subtitle: 'The same thirteen kernels in F# and in JavaScript, in your browser.', columns: 2 },
];
---

<Layout metadata={metadata}>
  <HeroText
    tagline="Try it"
    title="Live demos — F# in your browser"
    subtitle="Every demo is F# compiled to WebAssembly GC by fsharp-wasm and served from this site. Nothing to install: open one."
    callToAction={{
      variant: 'primary',
      text: 'All demos',
      href: 'https://fsharp-wasm.github.io/fsharp-wasm-runtime/',
      icon: 'tabler:apps',
    }}
    callToAction2={{
      variant: 'secondary',
      text: 'Run the benchmark',
      href: 'https://fsharp-wasm.github.io/fsharp-wasm-runtime/demos/bench/',
      icon: 'tabler:chart-bar',
    }}
  />

  {
    groups.map((g) => (
      <Features3
        tagline={g.tagline}
        title={g.title}
        subtitle={g.subtitle}
        columns={g.columns}
        items={demos
          .filter((d) => d.group === g.group)
          .map((d) => ({
            title: d.title,
            description: d.summary,
            icon: d.icon,
            callToAction: open(d),
          }))}
      />
    ))
  }

  <Features3
    tagline="Before you start"
    title="What your browser needs"
    subtitle="WebAssembly GC: Chrome and Edge 119 or later, Firefox 120 or later, Safari 18.2 or later. If a demo stays empty, that is the first thing to check — and tell us which browser it was."
    columns={3}
    items={[
      {
        title: 'Measured, not claimed',
        description: 'The benchmark runs the same thirteen kernels in F# and in JavaScript in your browser: <a href="/benchmarks">results and method</a>.',
        icon: 'tabler:chart-bar',
      },
      {
        title: 'The backend',
        description: 'The same F# runs on a server too: <a href="/backend">F# on the edge</a>, with an honest status.',
        icon: 'tabler:server',
      },
      {
        title: 'Source',
        description: 'Every demo is in <a href="https://github.com/fsharp-wasm/fsharp-wasm-runtime/tree/main/demos">fsharp-wasm-runtime</a>.',
        icon: 'tabler:brand-github',
      },
    ]}
  />

  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Get started',
        href: '/docs/getting-started',
        icon: 'tabler:rocket',
      },
      {
        text: 'fsharp-wasm-runtime on GitHub',
        href: 'https://github.com/fsharp-wasm/fsharp-wasm-runtime',
        target: '_blank',
        icon: 'tabler:brand-github',
      },
    ]}
  />
</Layout>

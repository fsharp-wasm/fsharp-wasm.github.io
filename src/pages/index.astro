---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import Note from '~/components/widgets/Note.astro';
import Features from '~/components/widgets/Features.astro';
import Steps from '~/components/widgets/Steps.astro';
import Content from '~/components/widgets/Content.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';
import Stats from '~/components/widgets/Stats.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'FSharp WasmGC — Compile F# to WebAssembly GC',
  ignoreTitleTemplate: true,
};
import { totals, recordedOn, recounts, featuredDemos } from '~/data/catalog';
import FeaturedDemos from '~/components/widgets/FeaturedDemos.astro';
import Features3 from '~/components/widgets/Features3.astro';
import { layers } from '~/data/projects';
---

<Layout metadata={metadata}>
  <!-- Hero ============================================================== -->
  <Hero
    actions={[
      {
        variant: 'primary',
        text: 'Get Started',
        href: '/docs/getting-started',
        icon: 'tabler:rocket',
      },
      {
        text: 'Sponsor',
        href: 'https://github.com/sponsors/fsharp-wasm',
        target: '_blank',
        icon: 'tabler:heart-filled',
      },
      {
        text: 'Live demos',
        href: '/demos',
        icon: 'tabler:player-play',
      },
      {
        text: 'All projects',
        href: '/projects',
        icon: 'tabler:layout-grid',
      },
      {
        text: 'View on GitHub',
        href: 'https://github.com/fsharp-wasm/fsharp-wasm',
        target: '_blank',
        icon: 'tabler:brand-github',
      },
    ]}
    image={{
      src: '~/assets/images/hero-wasm-terminal.png',
      alt: 'F# code compiling to WebAssembly in a terminal',
    }}
  >
    <Fragment slot="title">
      Write <span class="text-accent dark:text-white highlight">F#</span>.<br />
      Run in <span class="text-accent dark:text-white highlight">WebAssembly.</span>
    </Fragment>

    <Fragment slot="subtitle">
      <span class="hidden sm:inline">
        <strong>FSharp WasmGC</strong> compiles F# to <strong>WebAssembly GC</strong> — and around the compiler
        there is a platform: libraries, a graphics stack, editors and a server host, all written in F#.
      </span>
      Compact modules, no garbage collector and no runtime library to ship, in the browser and on the edge.
    </Fragment>
  </Hero>

  <!-- Featured demos: WasmOS leads ====================================== -->
  <FeaturedDemos
    id="demos"
    tagline="See it run"
    title="Real programs, in your browser"
    subtitle="F# compiled to WebAssembly GC by fsharp-wasm. Nothing to install: open one."
    items={featuredDemos}
  />

  <!-- Note ============================================================== -->
  <Note title="Built on Fable · WasmGC MVP Compliant · Apache-2.0 Licensed · Actively Developed" />

  <!-- Features ========================================================== -->
  <Features
    id="features"
    tagline="Why FSharp WasmGC?"
    title="F# semantics, natively in WebAssembly"
    subtitle="A compiler backend that maps F# constructs directly to WebAssembly GC types — no boxing hacks, and the engine's own garbage collector instead of one in the binary."
    items={[
      {
        title: 'Nothing to ship but your code',
        description:
          'WasmGC output uses the engine\'s garbage collector, so no GC or runtime sits inside the binary: whole demo applications are 6–172 KB. What a module touches outside itself — the DOM, the network, storage — comes through imports that a small host provides.',
        icon: 'tabler:bolt',
      },
      {
        title: 'Full F# Semantics',
        description:
          'Pattern matching, discriminated unions, closures, tail calls — all compile correctly to native WasmGC constructs without compromise.',
        icon: 'tabler:code',
      },
      {
        title: 'WasmGC-Native Types',
        description:
          'F# records map to struct types. F# lists become linked structs. Closures become typed function references. Clean mapping, no overhead.',
        icon: 'tabler:cube',
      },
      {
        title: 'Fable Foundation',
        description:
          "Built on a fork of Fable's F# parser and type-checker (MIT). The code generation back end, the base library and the hosts are ours.",
        icon: 'tabler:stack-2',
      },
      {
        title: 'Component Model Ready',
        description:
          'Automatic WIT export generation. Compile F# to WasmGC components and link them at the Wasm level — no JS glue needed between modules.',
        icon: 'tabler:plug',
      },
      {
        title: 'Apache-2.0 Licensed & Open Source',
        description:
          'Fully open. Community-driven development. Every sprint is documented in detail. Contributions welcome from day one.',
        icon: 'tabler:heart-handshake',
      },
    ]}
  />

  <!-- The platform ====================================================== -->
  <Features3
    id="platform"
    tagline="The platform"
    title="One language, from the compiler to the edge"
    subtitle="The compiler is the flagship, and what is built on it is the proof: libraries, a canvas graphics stack, a widget editor, a newsletter designer, server modules and the host that runs them. What works, what grows and what is only planned is written on each card."
    columns={3}
    items={layers.map((l) => ({
      title: l.title,
      description: `${l.projects.map((p) => p.name).join(', ')} — ${l.subtitle}`,
      icon: l.id === 'planned' ? 'tabler:telescope' : 'tabler:box',
      callToAction: { text: 'Details', href: `/projects#${l.id}`, icon: 'tabler:arrow-right' },
    }))}
  />

  <!-- How It Works — Steps ============================================== -->
  <Steps
    title="From F# to WebAssembly in four steps"
    items={[
      {
        title: 'Step 1: <span class="font-medium">Get the compiler</span>',
        description:
          'Download a release (a self-contained binary with the F# base library beside it) or build from source. A .NET 10 SDK has to be on the PATH.',
        icon: 'tabler:package',
      },
      {
        title: 'Step 2: <span class="font-medium">Write idiomatic F#</span>',
        description:
          'Create an .fsproj and write standard F#. No special attributes or interop layer needed for core functionality.',
        icon: 'tabler:pencil',
      },
      {
        title: 'Step 3: <span class="font-medium">Compile to WasmGC</span>',
        description:
          'Run the compiler. Get a .wasm binary and a human-readable .wat text representation you can inspect and debug.',
        icon: 'tabler:player-play',
      },
      {
        title: 'Step 4: <span class="font-medium">Deploy anywhere</span>',
        description:
          'Run it in a browser, Node, Deno or Bun, or on Cloudflare, Vercel and Netlify: hosts for those exist (see the demos and the backend page). Any WasmGC-capable runtime works.',
        icon: 'tabler:world',
      },
    ]}
    image={{
      src: '~/assets/images/how-it-works.png',
      alt: 'Diagram showing the F# to WasmGC compilation pipeline',
    }}
  />

  <!-- Content: Architecture ============================================= -->
  <Content
    isReversed
    tagline="Under the hood"
    title="Clean architecture, inspectable output"
    items={[
      {
        title: 'Fable front end + WasmGC code generation',
        description:
          'A fork of Fable provides the F# AST and the type information. FSharp WasmGC replaces the code generation back end.',
      },
      {
        title: 'Human-readable WAT intermediate format',
        description:
          'The compiler emits WebAssembly Text Format (WAT) before assembling. You can inspect exactly what Wasm your F# produces.',
      },
      {
        title: 'Multi-file .fsproj project support',
        description:
          'Compile entire projects with multiple F# source files and a growing Base Class Library (BCL) implemented in WasmGC itself.',
      },
    ]}
    image={{
      src: '~/assets/images/architecture-diagram.png',
      alt: 'Compiler architecture: F# source → Fable AST → WasmGC IR → WAT → .wasm',
    }}
  />

  <!-- Content: Component Model ========================================== -->
  <Content
    isAfterContent
    title="First-class Wasm Component Model"
    items={[
      {
        title: 'Automatic WIT interface generation',
        description:
          'WIT files are generated from your module\'s exports. Today that covers primitive types; strings and records need adapters in the module, which is the next step on the roadmap.',
      },
      {
        title: 'wasm-tools integration',
        description:
          'When wasm-tools is available, WasmGC components are assembled automatically. Link multiple F# modules at the Wasm level.',
      },
      {
        title: 'Cross-module FFI via [<Import>] attribute',
        description:
          "Import functions from other Wasm components using F#'s [<Import(\"name\",\"module\")>] attribute — the same pattern as Fable.",
      },
    ]}
    image={{
      src: '~/assets/images/component-model.png',
      alt: 'Diagram showing two F# WasmGC modules linked via the Component Model',
    }}
  />

  <!-- Stats ============================================================= -->
  <Stats
    title="Solid foundation, proven results"
    subtitle={`Counted in a recorded run on ${recordedOn}, and counted again for what changed since (${recounts.map((r) => `${r.what.join(', ')} on ${r.on}`).join('; ')}): every suite, demo and benchmark is listed on the Tests, Demos and Benchmarks pages.`}
    stats={[
      { title: 'named tests and checks', amount: totals.tests.toLocaleString('en-US').replace(/,/g, '\u202f') },
      { title: 'live demos in your browser', amount: `${totals.demos}` },
      { title: 'benchmark kernels, F# against JavaScript', amount: `${totals.kernels}` },
      { title: 'License', amount: 'Apache-2.0' },
    ]}
  />

  <!-- Benchmarks teaser ================================================= -->
  <CallToAction
    title="Benchmarks — measured and public"
    subtitle="Thirteen kernels in F# and in JavaScript, the size of every module and the time to download and compile it — and a server module against hand-written JavaScript and Hono on Node, Bun and workerd, where it is close on a small answer and far behind on a long one, with the profile of why. The method, the raw reports and what is not measured yet are with the numbers."
    actions={[
      {
        variant: 'secondary',
        text: 'See the benchmarks',
        href: '/benchmarks',
      },
      {
        variant: 'primary',
        text: 'Read the roadmap',
        href: '/docs/roadmap',
      },
    ]}
  />

  <!-- Blog Latest Posts ================================================= -->
  <BlogLatestPosts
    title="From the blog"
    information="Deep dives, release notes, and tutorials on F# compiler internals, WasmGC design, and functional programming for the web platform."
  />

  <!-- Final CTA ========================================================= -->
  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Read the docs',
        href: '/docs',
        icon: 'tabler:book',
      },
      {
        text: 'Star on GitHub',
        href: 'https://github.com/fsharp-wasm/fsharp-wasm',
        target: '_blank',
        icon: 'tabler:star',
      },
      {
        text: 'Sponsor the work',
        href: 'https://github.com/sponsors/fsharp-wasm',
        target: '_blank',
        icon: 'tabler:heart-filled',
      },
    ]}
  >
    <Fragment slot="title">
      Build the future of F# on the web
    </Fragment>

    <Fragment slot="subtitle">
      FSharp WasmGC is open source and actively developed. Contributions, issues, and discussions are all welcome on GitHub; <a class="underline" href="/sponsor">what sponsoring pays for</a> is written down, with what it has produced.
    </Fragment>
  </CallToAction>
</Layout>

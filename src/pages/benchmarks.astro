---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import Features3 from '~/components/widgets/Features3.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import Headline from '~/components/ui/Headline.astro';
import DataTable from '~/components/ui/DataTable.astro';
import { kernels, benchSuites } from '~/data/catalog';
import {
  speedColumns,
  speedRows,
  speedNote,
  sizeRows,
  sizeDate,
  sizeNote,
  pageRows,
  networkRows,
  networkProfiles,
  networkDate,
  encodings,
  hostRows,
  hostNote,
} from '~/data/runtimeBench';

const reports = 'https://github.com/fsharp-wasm/fsharp-wasm-runtime/tree/main/site/benchmarks';
const benchDemo = 'https://fsharp-wasm.github.io/fsharp-wasm-runtime/demos/bench/';
const measureYourself = 'https://fsharp-wasm.github.io/fsharp-wasm-runtime/benchmarks/#live';

const metadata = {
  title: 'Benchmarks',
};
---

<Layout metadata={metadata}>
  <!-- Hero ============================================================== -->
  <HeroText
    tagline="Performance"
    title="Benchmarks — measured and public"
    subtitle="Thirteen compute kernels in F# (compiled to WasmGC by fsharp-wasm) and in plain JavaScript, on Node, Deno, Bun and Chromium; the size of every compiled module; and the time to download and compile it on Wi-Fi, 4G and 3G."
    callToAction={{
      variant: 'primary',
      text: 'See the results',
      href: '#speed',
      icon: 'tabler:chart-bar',
    }}
    callToAction2={{
      variant: 'secondary',
      text: 'Backend benchmarks',
      href: '/benchmarks/backend',
      icon: 'tabler:cloud',
    }}
  />

  <!-- What is measured ================================================= -->
  <Features3
    title="What is measured"
    subtitle="One machine (a 4-vCPU virtual machine), recorded as it came out; the raw reports are published next to the tables. How to read them: docs/benchmarks.md in fsharp-wasm-runtime."
    columns={3}
    items={[
      {
        title: 'Speed',
        description:
          'On V8 (Node, Deno, Chromium) the F# module is faster in 9–11 of 13 kernels; the geometric mean against JavaScript is 1.45–1.58× without the list pipeline the compiler fuses into one loop. On JavaScriptCore (Bun) it is 1.03×. Part of the V8 result is V8 inlining small functions: with its inliner off the mean drops from 1.45× to 1.27×.',
        icon: 'tabler:cpu',
      },
      {
        title: 'Binary size',
        description:
          'Modules are 12–153 KB raw and 4–45 KB with brotli (27–37 % of the raw size). Only the two graphics modules, the widget editor and the scene gallery, are larger than 12 KB compressed. For the small demos the JavaScript glue weighs as much as the module.',
        icon: 'tabler:file-zip',
      },
      {
        title: 'Network',
        description:
          'Latency, not size, dominates the small modules: a 7 KB module takes 0.40 s on 3G, 0.30 s of it the round trip. The widget editor needs 0.89 s on 3G with gzip (1.89 s without). GitHub Pages sends gzip, not brotli. Emulated network; a button measures your own line.',
        icon: 'tabler:clock-bolt',
      },
    ]}
  />

  <!-- The kernels =================================================== -->
  <WidgetWrapper id="kernels">
    <Headline
      tagline="Speed"
      title="The thirteen kernels"
      subtitle="Each is written twice, in F# and in plain JavaScript, with the same algorithm and the same order of operations; before any time counts, both sides must return the same checksum."
      classes={{ container: 'mb-6 md:mb-8' }}
    />
    <div class="max-w-5xl mx-auto overflow-x-auto">
      <table class="w-full text-left text-sm border-collapse">
        <caption class="sr-only">The benchmark kernels, what each stresses and its standard size</caption>
        <thead>
          <tr class="border-b border-slate-300 dark:border-slate-600">
            <th scope="col" class="py-2 pr-4">Kernel</th>
            <th scope="col" class="py-2 pr-4">What it stresses</th>
            <th scope="col" class="py-2">Standard size</th>
          </tr>
        </thead>
        <tbody>
          {
            kernels.map((k) => (
              <tr class="border-b border-slate-200 dark:border-slate-700 align-top">
                <th scope="row" class="py-2 pr-4 font-semibold">{k.name}{k.note ? ' †' : ''}</th>
                <td class="py-2 pr-4 text-muted">{k.stresses}</td>
                <td class="py-2 text-muted">{k.standard}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
      <p class="mt-3 text-sm text-muted">† {kernels.find((k) => k.note)?.note}</p>
    </div>
  </WidgetWrapper>

  <!-- Speed: the recorded results ============================================ -->
  <WidgetWrapper id="speed">
    <Headline
      tagline="Speed"
      title="F# against JavaScript, kernel by kernel"
      subtitle="How many times faster the F# module is than the JavaScript: above 1 the module wins and the number is coloured. The median of the recorded runs, and in brackets the range of the runs; ⚠ marks a kernel whose samples spread over more than a quarter of their median."
      classes={{ container: 'mb-6 md:mb-8' }}
    />
    <DataTable
      caption="Speed of the F# module against JavaScript per kernel and engine: how many times faster the module is"
      columns={[
        { label: 'Kernel', nowrap: true },
        ...speedColumns.map((c) => ({ label: c.name, sub: c.runs.length > 1 ? `${c.runs.length} runs` : undefined, align: 'right' as const })),
      ]}
      rows={speedRows}
      totalRows={2}
    />
    <div class="max-w-5xl mx-auto mt-3 text-sm text-muted">
      <p>
        {speedNote} † the list pipeline that the compiler fuses into one loop, which JavaScript does not; the geometric mean is given with and without it. The raw reports: <a class="underline" href={reports} target="_blank" rel="noopener">site/benchmarks</a>.
      </p>
      <p class="mt-4">
        <a class="btn-primary" href={benchDemo} target="_blank" rel="noopener">Run the thirteen kernels in your browser</a>
      </p>
    </div>
  </WidgetWrapper>

  <!-- Size ========================================================================== -->
  <WidgetWrapper id="size">
    <Headline
      tagline="Size"
      title="What a module weighs"
      subtitle={`Raw, gzip and brotli size of every module (${sizeDate}). ${sizeNote}`}
      classes={{ container: 'mb-6 md:mb-8' }}
    />
    <DataTable
      caption="Size of every compiled module, raw, with gzip and with brotli"
      columns={[
        { label: 'Module' },
        { label: 'raw', align: 'right' },
        { label: 'gzip', align: 'right' },
        { label: 'brotli', align: 'right' },
        { label: 'brotli ÷ raw', align: 'right' },
      ]}
      rows={sizeRows}
      width="max-w-3xl"
    />
    <h3 class="max-w-5xl mx-auto mt-12 mb-4 text-xl font-bold">What a page loads</h3>
    <DataTable
      caption="What each page of the showcase loads: requests and bytes"
      columns={[
        { label: 'Page' },
        { label: 'requests', align: 'right' },
        { label: 'raw', align: 'right' },
        { label: 'gzip', align: 'right' },
        { label: 'brotli', align: 'right' },
        { label: 'the largest two' },
      ]}
      rows={pageRows}
    />
  </WidgetWrapper>

  <!-- Network ========================================================================= -->
  <WidgetWrapper id="network">
    <Headline
      tagline="Network"
      title="Download plus compile, on five networks"
      subtitle={`Every module on an emulated network (${networkDate}), three runs; the time to download it and to compile it. Latency, not size, dominates the small modules.`}
      classes={{ container: 'mb-6 md:mb-8' }}
    />
    {
      encodings.map((e, i) => (
        <details class="max-w-5xl mx-auto mb-4" open={i === 0}>
          <summary class="cursor-pointer font-semibold py-2">{e.label}</summary>
          <DataTable
            caption={`Time to download and compile every module, sent with ${e.label}`}
            columns={[
              { label: 'Module' },
              { label: 'on the wire', align: 'right' },
              ...networkProfiles.map((p) => ({ label: p.label, sub: p.mbps ? `${p.mbps} Mbps, ${p.rtt} ms` : 'no limit', align: 'right' as const })),
            ]}
            rows={networkRows(e.id)}
          />
        </details>
      ))
    }
    <h3 class="max-w-5xl mx-auto mt-12 mb-2 text-xl font-bold">The real host</h3>
    <p class="max-w-5xl mx-auto mb-4 text-sm text-muted">
      {hostNote} GitHub Pages sends gzip and no brotli: asked for brotli it answers with the file as it is.
    </p>
    <DataTable
      caption="Time to fetch every module from the host: no compression, gzip, brotli"
      columns={[
        { label: 'Module' },
        { label: 'raw', align: 'right' },
        { label: 'sent as gzip', align: 'right' },
        { label: 'request: none / gzip / brotli', align: 'right' },
      ]}
      rows={hostRows}
      width="max-w-3xl"
    />
    <p class="max-w-5xl mx-auto mt-6 text-sm text-muted">
      Your own line is another matter: <a class="underline" href={measureYourself} target="_blank" rel="noopener">a button on the runtime's page</a> downloads and compiles every module from this host and shows what it took.
    </p>
  </WidgetWrapper>

  <!-- The suites ====================================================== -->
  <WidgetWrapper id="suites">
    <Headline
      tagline="Everything we measure"
      title="Six benchmark suites"
      subtitle="Where each lives, what it records, and the command that reproduces it."
      classes={{ container: 'mb-6 md:mb-8' }}
    />
    <ul class="max-w-5xl mx-auto grid gap-6 sm:grid-cols-2 list-none p-0">
      {
        benchSuites.map((b) => (
          <li class="rounded-md border border-slate-200 dark:border-slate-700 p-5">
            <h3 class="text-xl font-bold">{b.title}</h3>
            <p class="mt-2 text-muted">{b.summary}</p>
            {b.run && (
              <p class="mt-3 text-sm">
                Run: <code class="break-words">{b.run}</code>
              </p>
            )}
            <p class="mt-3 text-sm">
              {b.href && (
                <a href={b.href} class="underline" {...(b.href.startsWith('http') ? { target: '_blank', rel: 'noopener' } : {})}>
                  Open
                </a>
              )}
              {b.href && ' · '}
              <span class="text-muted">{b.where}</span>
            </p>
          </li>
        ))
      }
    </ul>
  </WidgetWrapper>

  <!-- What is not measured yet ======================================== -->
  <Features3
    title="Not measured yet"
    subtitle="Planned, not done: we publish what exists."
    columns={3}
    items={[
      {
        title: 'Startup of whole applications',
        description: 'Only module size, download and compile time are recorded, not the time to a first interaction of a page.',
        icon: 'tabler:clock',
      },
      {
        title: 'Memory and GC',
        description: 'No peak heap or pause measurements yet; the binary-trees kernel shows throughput only.',
        icon: 'tabler:database',
      },
      {
        title: 'Compile time and other engines',
        description: 'End-to-end compile time of the compiler, and Firefox and Safari, are not measured.',
        icon: 'tabler:terminal-2',
      },
    ]}
  />

  <!-- Comparison targets ============================================= -->
  <Features3
    title="Comparison targets"
    subtitle="Hand-written JavaScript is measured today. The others are planned: the same programs in comparable technologies."
    columns={2}
    items={[
      {
        title: 'Fable → JavaScript',
        description:
          'The same F# code compiled by Fable to JavaScript — the closest apples-to-apples comparison for F# semantics.',
        icon: 'tabler:brand-javascript',
      },
      {
        title: 'Blazor WebAssembly',
        description: "Microsoft's .NET-on-Wasm stack — a different approach with a much larger runtime footprint.",
        icon: 'tabler:brand-windows',
      },
      {
        title: 'Hand-written JavaScript',
        description: 'Idiomatic JS implementations of the same algorithms — the baseline that Wasm needs to beat.',
        icon: 'tabler:code',
      },
      {
        title: 'Kotlin/Wasm',
        description: "Kotlin's WasmGC backend — another typed functional language targeting the same runtime.",
        icon: 'tabler:brand-kotlin',
      },
    ]}
  />

  <!-- CTA ============================================================= -->
  <CallToAction
    title="Want to help shape the benchmarks?"
    subtitle="We welcome benchmark contributions, methodology proposals, and real-world workloads from the community. If you have a use-case you would like us to measure, open an issue."
    actions={[
      {
        variant: 'primary',
        text: 'Open an issue on GitHub',
        href: 'https://github.com/fsharp-wasm/fsharp-wasm/issues',
        target: '_blank',
        icon: 'tabler:brand-github',
      },
      {
        variant: 'secondary',
        text: 'Read the roadmap',
        href: '/docs/roadmap',
      },
    ]}
  />
</Layout>

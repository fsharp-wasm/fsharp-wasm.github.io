---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import Stats from '~/components/widgets/Stats.astro';
import Features3 from '~/components/widgets/Features3.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import Headline from '~/components/ui/Headline.astro';
import { tests, totals, recordedOn, repoUrl } from '~/data/catalog';

const metadata = {
  title: 'Tests',
  description: `Every test suite of every fsharp-wasm repository: what it checks, how many tests, how to run it, and whether CI runs it. Recorded ${recordedOn}.`,
};

const fmt = (n: number) => n.toLocaleString('en-US').replace(/,/g, ' ');
const suiteCount = (s: { count?: number; workload?: string }) =>
  s.count !== undefined ? fmt(s.count) : '—';
---

<Layout metadata={metadata}>
  <HeroText
    tagline="Quality"
    title="Tests — what is checked, and how much"
    subtitle={`Every suite of every repository: what it checks, how many tests, how to run it, and whether the repository's CI runs it. The counts are from a recorded run on ${recordedOn}; the CI badge of each repository is the live truth.`}
    callToAction={{
      variant: 'primary',
      text: 'Run them yourself',
      href: 'https://github.com/fsharp-wasm/fsharp-wasm#3-run-tests',
      target: '_blank',
      icon: 'tabler:terminal-2',
    }}
    callToAction2={{
      variant: 'secondary',
      text: 'Benchmarks',
      href: '/benchmarks',
      icon: 'tabler:chart-bar',
    }}
  />

  <Stats
    stats={[
      { title: 'named tests and checks', amount: fmt(totals.tests), icon: 'tabler:checklist' },
      { title: 'test suites', amount: `${totals.suites}`, icon: 'tabler:list-details' },
      { title: 'repositories', amount: `${totals.repos}`, icon: 'tabler:brand-github' },
      { title: 'generated calls, .NET against wasm: 0 disagreements', amount: '183 012', icon: 'tabler:equal' },
    ]}
  />

  <WidgetWrapper id="reading">
    <div class="max-w-3xl mx-auto text-muted">
      <p>
        A <strong>named test or check</strong> is one line of a suite's output; the total counts each once (the platform checks are counted once, not per target).
        A <strong>workload</strong> is generated input — random programs, a fuzzer, a differential run — and is described next to the suite, not added to the total.
        <strong>In CI</strong> says whether that repository's workflow runs the suite on every push. A suite that does not pass right now is listed with its status.
      </p>
    </div>
  </WidgetWrapper>

  {
    tests.map((group) => (
      <WidgetWrapper id={group.repo}>
        <Headline
          tagline="Repository"
          title={group.repo}
          subtitle={group.summary}
          classes={{ container: 'mb-6 md:mb-8' }}
        />
        <div class="max-w-6xl mx-auto overflow-x-auto">
          <table class="w-full text-left text-sm border-collapse">
            <caption class="sr-only">Test suites of {group.repo}</caption>
            <thead>
              <tr class="border-b border-slate-300 dark:border-slate-600">
                <th scope="col" class="py-2 pr-4">Suite</th>
                <th scope="col" class="py-2 pr-4">What it checks</th>
                <th scope="col" class="py-2 pr-4 text-right">Tests</th>
                <th scope="col" class="py-2 pr-4">In CI</th>
                <th scope="col" class="py-2">Run</th>
              </tr>
            </thead>
            <tbody>
              {group.suites.map((s) => (
                <tr class="border-b border-slate-200 dark:border-slate-700 align-top">
                  <th scope="row" class="py-3 pr-4 font-semibold">{s.name}</th>
                  <td class="py-3 pr-4 text-muted">
                    {s.what}
                    {s.workload && <div class="mt-1 text-xs">Workload: {s.workload}</div>}
                    {s.status && (
                      <div class="mt-1 text-xs font-semibold text-amber-700 dark:text-amber-400">Status: {s.status}</div>
                    )}
                  </td>
                  <td class="py-3 pr-4 text-right tabular-nums">{suiteCount(s)}</td>
                  <td class="py-3 pr-4">{s.ci === 'yes' ? 'yes' : 'no'}</td>
                  <td class="py-3"><code class="text-xs break-words">{s.run}</code></td>
                </tr>
              ))}
            </tbody>
          </table>
          <p class="mt-3 text-sm">
            <a href={repoUrl(group.repo)} class="underline">{group.repo} on GitHub</a>
          </p>
        </div>
      </WidgetWrapper>
    ))
  }

  <Features3
    tagline="Honestly"
    title="What is not tested yet"
    subtitle="Planned, not done: we publish what exists."
    columns={3}
    items={[
      {
        title: 'Other browsers',
        description: 'The browser tests run in Chromium. Firefox and Safari run WebAssembly GC, but the demos and benchmarks are not tested there.',
        icon: 'tabler:browser',
      },
      {
        title: 'Real deployments',
        description: 'The host runs on eight targets in a test matrix, some of them emulations of a platform. Nothing is deployed to Cloudflare, Vercel or Netlify yet, so the live check has not run against a real address.',
        icon: 'tabler:cloud-off',
      },
      {
        title: 'Accessibility',
        description: 'The canvas demos draw pixels and have no accessible tree. There are no automated accessibility checks yet; they come with the HTML GUI layer on the roadmap.',
        icon: 'tabler:accessible',
      },
    ]}
  />

  <CallToAction
    title="Found a program that does not compile?"
    subtitle="An issue with the F# source is the best bug report: it becomes a test."
    actions={[
      {
        variant: 'primary',
        text: 'Open an issue',
        href: 'https://github.com/fsharp-wasm/fsharp-wasm/issues',
        target: '_blank',
        icon: 'tabler:brand-github',
      },
      { text: 'Examples', href: '/examples', icon: 'tabler:code' },
    ]}
  />
</Layout>

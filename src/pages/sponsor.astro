---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import Stats from '~/components/widgets/Stats.astro';
import Features3 from '~/components/widgets/Features3.astro';
import Content from '~/components/widgets/Content.astro';
import Table from '~/components/widgets/Table.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import { totals, recordedOn } from '~/data/catalog';

const metadata = {
  title: 'Sponsor',
  description:
    'The sponsor tiers, the funding goals with what each pays for, the way for companies, what the work has produced so far (measured, with the method), and what it does not promise.',
};

const fmt = (n: number) => n.toLocaleString('en-US').replace(/,/g, ' ');
const org = 'https://github.com/fsharp-wasm';
---

<Layout metadata={metadata}>
  <HeroText
    tagline="Support the work"
    title="Sponsor fsharp-wasm"
    subtitle="F# that compiles to small, fast WebAssembly GC modules, with the libraries, hosts and tools around it. It is experimental, it is open (Apache-2.0), and everything we claim comes with the way to check it."
    callToAction={{
      variant: 'primary',
      text: 'Sponsor on GitHub',
      href: 'https://github.com/sponsors/fsharp-wasm',
      target: '_blank',
      icon: 'tabler:heart',
    }}
    callToAction2={{
      variant: 'secondary',
      text: 'See what exists',
      href: '/tests',
      icon: 'tabler:checklist',
    }}
  />

  <Stats
    stats={[
      { title: 'named tests and checks, recorded ' + recordedOn, amount: fmt(totals.tests), icon: 'tabler:checklist' },
      { title: 'test suites in ' + totals.repos + ' repositories', amount: `${totals.suites}`, icon: 'tabler:list-details' },
      { title: 'calls compared with .NET, 0 disagreements', amount: '183 012', icon: 'tabler:equal' },
      { title: 'live demos that run in your browser', amount: `${totals.demos}`, icon: 'tabler:player-play' },
    ]}
  />

  <Table
    tagline="Tiers"
    title="For individuals"
    subtitle="Set 2026-11-26. Every tier is a tier of GitHub Sponsors; the name on the list is optional."
    columns={['Tier', 'Per month', 'What you get']}
    rows={[
      ['Supporter', '$5 &ndash; $15', 'Your name on the list of sponsors of this page, if you want it there.'],
      ['Indie backer', '$50', 'The above, and your bug reports and questions are answered first.'],
    ]}
  />

  <Table
    isDark
    tagline="Tiers"
    title="For companies and teams"
    subtitle="What a team gets for a fixed amount that fits a budget. A company that depends on a tool for its work has a say in where the work goes."
    columns={['Tier', 'Per month', 'What you get']}
    rows={[
      ['Bronze', '$250', 'Your logo and a link on this page and in the README of fsharp-wasm.'],
      ['Silver', '$500', 'The above, and a say in the order of the roadmap: what you name is weighed with what the other sponsors name (a vote, not a veto).'],
      ['Gold, founding partner', '$1 500 and up', 'The above, and an agreed number of engineering hours a month for your own use case: bringing the compiler into an existing F# codebase, a host binding, an optimisation. The hours and what they are for are set in writing with you.'],
    ]}
    note={'Sponsor as an organisation on GitHub Sponsors; where your organisation pays GitHub by invoice, the sponsorship is on that invoice. A direct invoice, or a written agreement for the hours of a Gold sponsorship: <a class="underline" href="/contact">write to us</a>.'}
  />

  <Features3
    tagline="What it pays for"
    title="Where the time goes"
    subtitle="Time, mostly. Each item is something that exists in a measured state today and has a concrete next step."
    columns={3}
    items={[
      {
        title: 'A compiler that covers more of F#',
        description:
          'Gaps are found by writing programs and listed in <a href="https://github.com/fsharp-wasm/fsharp-wasm/blob/main/docs/STATUS.md">STATUS.md</a> with the test that shows each one. A batch was closed on 2026-11-16 (ranges with a step, slices, `Array.concat`, `StringBuilder.AppendLine` and more); `%A` of records and unions, local generic functions and `async` are next.',
        icon: 'tabler:code',
      },
      {
        title: 'Accessibility of the widget toolkit',
        description:
          'Measured: the widget editor exposes one node to a screen reader, cannot be used from the keyboard, and 8 of 19 (dark theme) and 12 of 19 (light theme) colour pairs miss WCAG AA. The plan (semantics in the scene, an ARIA overlay, keyboard in the toolkit, AA colours) is in <a href="https://github.com/fsharp-wasm/fsharp-wasm-graphics/blob/develop/docs/accessibility.md">docs/accessibility.md</a>.',
        icon: 'tabler:accessible',
      },
      {
        title: 'Documentation that developers can follow',
        description:
          'A first-ten-minutes path that runs, concepts, how-tos and a reference generated from the code, with the examples executed in CI so the pages cannot rot.',
        icon: 'tabler:book',
      },
      {
        title: 'Running on the edge',
        description:
          'One backend module answers identically on eight test targets today. Real deployments on Cloudflare, Vercel and Netlify, and the Component Model glue that lets a host link modules, are the next step.',
        icon: 'tabler:cloud',
      },
      {
        title: 'Staying mergeable with upstream',
        description:
          'The compiler builds on forks of F# and Fable. Taking their changes without breaking what is pinned is steady work with a written policy, and it keeps the door open for sending changes upstream.',
        icon: 'tabler:git-merge',
      },
      {
        title: 'Tests, benchmarks and the pages that show them',
        description:
          'Every suite, every benchmark kernel and every demo is listed with how to run it. Keeping that true, and widening it (other browsers, real deployments), is part of the work.',
        icon: 'tabler:chart-bar',
      },
    ]}
  />

  <Table
    tagline="Goals"
    title="What the money unlocks, step by step"
    subtitle="Set 2026-11-26. The progress is on GitHub Sponsors; this is what each step pays for, and where the work stands today."
    columns={['Goal', 'Per month', 'What it pays for', 'Where it stands today']}
    rows={[
      ['Goal 1', '10 sponsors, about $500 &ndash; $1 000', 'Incorporating the organisation, so that companies can contract it and be invoiced; and live deployments of the edge host on Cloudflare, Vercel and Netlify, with public addresses for the Ghost Todo demo.', 'One backend module answers identically on eight test targets; no deployment is live yet.'],
      ['Goal 2', '$2 500', 'Part-time funding of the Component Model work (WIT interfaces to Rust crates) and of the native desktop shell for Windows, macOS and Linux.', 'WIT exports are generated and two modules link at the Wasm level (two checks of the compiler suite). Calling a Rust crate through WIT is not done. The shell is a probe page and a browser demo (WasmOS); there is no native host yet.'],
      ['Goal 3', '$5 000 and up', 'Focused work, up to full time, on the device APIs for iOS and Android (fsharp-wasm-mobile) and on the accessible GUI framework: semantic DOM, keyboard, screen readers.', 'fsharp-wasm-mobile has the catalogue of the APIs, and the native implementations are the work. The accessibility baseline is measured (above) and the semantics of the canvas are in progress.'],
    ]}
  />

  <Content
    isReversed
    tagline="Honestly"
    title="What it does not promise"
    items={[
      { title: 'No promised schedule', description: 'Sponsorship buys time on the work across the repositories. Until Goal 3 is funded it is done beside other work, and no tier buys a date or a feature that is not agreed in writing.' },
      { title: 'No hidden status', description: 'What exists and what is intended are listed apart, and the numbers on this site are from a recorded run with the date next to them.' },
      { title: 'No lock-in', description: 'Apache-2.0 for what we wrote (the two forks stay MIT), no sign-up, no tracking scripts on this site.' },
    ]}
    image={{ src: '~/assets/images/hero-image.png', alt: '' }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">The method is part of the offer</h3>
      A claim without a way to check it is marketing. The test counts come from <code>tests/run-all.sh</code>, the speed
      comparison names its machine and what it does <em>not</em> measure, and the accessibility numbers come from a script in the
      repository that anyone can run against the live pages.
    </Fragment>
  </Content>

  <CallToAction
    title="Not able to sponsor? Help in other ways"
    subtitle="A failing program as an issue with the F# source becomes a test. A benchmark we should add, a platform to run on, a page of documentation that was unclear: all of it counts."
    actions={[
      {
        variant: 'primary',
        text: 'Sponsor the organization',
        href: 'https://github.com/sponsors/fsharp-wasm',
        target: '_blank',
        icon: 'tabler:heart',
      },
      { text: 'Join in', href: '/community', icon: 'tabler:users' },
    ]}
  />
</Layout>

---
import type { Cell, Column } from './dataTable';

interface Props {
  caption: string;
  columns: Column[];
  rows: Array<Array<string | Cell>>;
  /** the width the table may take: `max-w-5xl` for wide tables, `max-w-3xl` for narrow ones */
  width?: 'max-w-3xl' | 'max-w-5xl' | 'max-w-6xl';
  /** how many of the last rows are totals (a mean, a sum): set off with a heavier rule and bold */
  totalRows?: number;
}

const { caption, columns, rows, width = 'max-w-5xl', totalRows = 0 } = Astro.props;
const cell = (c: string | Cell): Cell => (typeof c === 'string' ? { text: c } : c);
const align = (i: number) => (columns[i]?.align === 'right' ? 'text-right tabular-nums' : 'text-left');
const split = rows.length - totalRows;
---

<div class={`${width} mx-auto overflow-x-auto`}>
  <table class="w-full text-sm border-collapse">
    <caption class="sr-only">{caption}</caption>
    <thead>
      <tr class="border-b border-slate-300 dark:border-slate-600">
        {
          columns.map((c, i) => (
            <th scope="col" class={`py-2 pr-4 align-bottom ${align(i)} ${c.nowrap ? 'whitespace-nowrap' : ''}`}>
              {c.hidden ? <span class="sr-only">{c.label}</span> : c.label}
              {c.sub && <span class="block text-xs font-normal text-muted">{c.sub}</span>}
            </th>
          ))
        }
      </tr>
    </thead>
    <tbody>
      {
        rows.map((row, r) => (
          <tr class={`border-b ${r === split - 1 && totalRows > 0 ? 'border-slate-300 dark:border-slate-600' : 'border-slate-200 dark:border-slate-700'} ${r >= split ? 'font-semibold' : ''}`}>
            {row.map((raw, i) => {
              const c = cell(raw);
              const tone = c.good ? 'font-semibold text-primary' : c.strong ? 'font-semibold' : c.muted ? 'text-muted' : '';
              return i === 0 ? (
                <th scope="row" title={c.title} class={`py-2 pr-4 text-left font-semibold ${columns[0]?.nowrap ? 'whitespace-nowrap' : ''}`}>
                  {c.text}
                  {c.sub && <span class="block text-xs font-normal text-muted">{c.sub}</span>}
                </th>
              ) : c.bar !== undefined ? (
                <td class="py-2 w-40" title={c.title}>
                  <span class="sr-only">{c.text}</span>
                  <div class="h-2 rounded bg-slate-200 dark:bg-slate-700" aria-hidden="true">
                    <div class="h-2 rounded bg-secondary" style={`width:${Math.max(0, Math.min(1, c.bar)) * 100}%`} />
                  </div>
                </td>
              ) : (
                <td title={c.title} class={`py-2 pr-4 ${align(i)} ${tone} ${columns[i]?.nowrap ? 'whitespace-nowrap' : ''}`}>
                  {c.text}
                  {c.sub && <span class="block text-xs font-normal text-muted">{c.sub}</span>}
                </td>
              );
            })}
          </tr>
        ))
      }
    </tbody>
  </table>
</div>

---
/**
 * DocsLayout — two-column docs layout with sticky sidebar.
 * Uses Tailwind CSS utility classes only — no custom CSS required.
 * The sidebar is hidden on small screens; on mobile the slot "mobile-nav"
 * renders a simple back link via the default fallback.
 */
import { getCollection } from 'astro:content';
import Layout from './PageLayout.astro';
import { Icon } from 'astro-icon/components';

interface Props {
  metadata: { title: string; description?: string };
  currentId: string;
}

const { metadata, currentId } = Astro.props;

const docs = await getCollection('docs');
const sorted = docs.sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));

const currentIndex = sorted.findIndex((d) => d.id === currentId);
const prev = currentIndex > 0 ? sorted[currentIndex - 1] : null;
const next = currentIndex < sorted.length - 1 ? sorted[currentIndex + 1] : null;
---

<Layout metadata={metadata}>
  <div class="max-w-screen-xl mx-auto px-4 sm:px-6 py-8 lg:py-12">
    <div class="lg:grid lg:grid-cols-[16rem_1fr] lg:gap-10 xl:grid-cols-[18rem_1fr]">

      <!-- ── Sidebar ──────────────────────────────────────────────────── -->
      <aside class="hidden lg:block">
        <div class="sticky top-24 overflow-y-auto max-h-[calc(100vh-6rem)]">
          <nav aria-label="Documentation navigation">
            <p class="mb-3 px-2 text-xs font-semibold uppercase tracking-widest text-gray-500 dark:text-gray-400">
              Documentation
            </p>
            <ul class="space-y-0.5">
              {sorted.map((doc) => {
                const isActive = doc.id === currentId;
                return (
                  <li>
                    <a
                      href={`/docs/${doc.id}`}
                      class:list={[
                        'flex items-center gap-2 rounded-lg px-3 py-2 text-sm transition-colors',
                        isActive
                          ? 'bg-primary/10 text-primary dark:bg-violet-900/30 dark:text-violet-300 font-semibold'
                          : 'text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-800 hover:text-gray-900 dark:hover:text-white',
                      ]}
                      aria-current={isActive ? 'page' : undefined}
                    >
                      <Icon
                        name={isActive ? 'tabler:file-filled' : 'tabler:file-text'}
                        class="w-4 h-4 shrink-0 opacity-70"
                      />
                      {doc.data.title}
                    </a>
                  </li>
                );
              })}
            </ul>

            <div class="mt-8 border-t border-gray-200 dark:border-gray-700 pt-6 space-y-0.5">
              <p class="mb-3 px-2 text-xs font-semibold uppercase tracking-widest text-gray-500 dark:text-gray-400">
                More
              </p>
              <a
                href="https://github.com/fsharp-wasm/fsharp-wasm"
                target="_blank"
                rel="noopener"
                class="flex items-center gap-2 rounded-lg px-3 py-2 text-sm text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-800 hover:text-gray-900 dark:hover:text-white transition-colors"
              >
                <Icon name="tabler:brand-github" class="w-4 h-4 shrink-0 opacity-70" />
                GitHub Repository
              </a>
              <a
                href="https://github.com/fsharp-wasm/fsharp-wasm/issues"
                target="_blank"
                rel="noopener"
                class="flex items-center gap-2 rounded-lg px-3 py-2 text-sm text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-800 hover:text-gray-900 dark:hover:text-white transition-colors"
              >
                <Icon name="tabler:message-circle" class="w-4 h-4 shrink-0 opacity-70" />
                Open an Issue
              </a>
            </div>
          </nav>
        </div>
      </aside>

      <!-- ── Main content ─────────────────────────────────────────────── -->
      <main class="min-w-0">
        <!-- Mobile: back link -->
        <div class="lg:hidden mb-6">
          <a
            href="/docs"
            class="inline-flex items-center gap-1 text-sm text-primary dark:text-accent hover:underline"
          >
            <Icon name="tabler:chevron-left" class="w-4 h-4" />
            All documentation
          </a>
        </div>

        <!-- Prose content -->
        <article
          class="prose prose-lg dark:prose-invert max-w-none
                 prose-headings:font-heading prose-headings:leading-tight
                 prose-a:text-primary dark:prose-a:text-accent
                 prose-code:bg-gray-100 dark:prose-code:bg-gray-800 prose-code:rounded prose-code:px-1
                 prose-pre:rounded-xl prose-pre:shadow-md"
        >
          <slot />
        </article>

        <!-- Prev / Next navigation -->
        {(prev || next) && (
          <nav
            aria-label="Pagination"
            class="mt-12 pt-8 border-t border-gray-200 dark:border-gray-700 flex flex-col sm:flex-row gap-4"
          >
            {prev && (
              <a
                href={`/docs/${prev.id}`}
                class="group flex-1 flex flex-col gap-1 rounded-xl border border-gray-200 dark:border-gray-700 px-5 py-4 text-sm hover:border-primary dark:hover:border-accent transition-colors"
              >
                <span class="text-xs text-gray-500 dark:text-gray-400 flex items-center gap-1">
                  <Icon name="tabler:arrow-left" class="w-3 h-3" />
                  Previous
                </span>
                <span class="font-medium text-gray-900 dark:text-white group-hover:text-primary dark:group-hover:text-accent transition-colors">
                  {prev.data.title}
                </span>
              </a>
            )}
            {next && (
              <a
                href={`/docs/${next.id}`}
                class="group flex-1 flex flex-col gap-1 items-end rounded-xl border border-gray-200 dark:border-gray-700 px-5 py-4 text-sm hover:border-primary dark:hover:border-accent transition-colors"
              >
                <span class="text-xs text-gray-500 dark:text-gray-400 flex items-center gap-1">
                  Next
                  <Icon name="tabler:arrow-right" class="w-3 h-3" />
                </span>
                <span class="font-medium text-gray-900 dark:text-white group-hover:text-primary dark:group-hover:text-accent transition-colors">
                  {next.data.title}
                </span>
              </a>
            )}
          </nav>
        )}

        <!-- Edit on GitHub -->
        <div class="mt-8 flex justify-end">
          <a
            href={`https://github.com/fsharp-wasm/fsharp-wasm.github.io/blob/main/src/content/docs/${currentId}.md`}
            target="_blank"
            rel="noopener"
            class="inline-flex items-center gap-1.5 text-xs text-gray-500 dark:text-gray-400 hover:text-primary dark:hover:text-accent transition-colors"
          >
            <Icon name="tabler:edit" class="w-3.5 h-3.5" />
            Edit this page on GitHub
          </a>
        </div>
      </main>
    </div>
  </div>
</Layout>
